<UserControl x:Class="project_03.Views.FleetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource DarkBgBrush}"
             Loaded="UserControl_Loaded">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Filter by section (NEW) -->
            <RowDefinition Height="Auto"/> <!-- Chips + summary -->
            <RowDefinition Height="Auto"/> <!-- Column headers -->
            <RowDefinition Height="*"/> <!-- Rows -->
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Flotte" Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Gérer tous les véhicules de votre flotte de location"
                           Style="{StaticResource SubHeaderTextStyle}" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButtonStyle}" x:Name="btn_AddNewCar" Click="btn_AddNewCar_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Plus"
                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                            Width="16" Height="16"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"/>
                        <TextBlock Text="Ajouter un véhicule" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ Filter bar + summary ============ -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" x:Name="FilterStatusStack">
                <RadioButton x:Name="rdbtn_Tous" Style="{StaticResource FilterRadioChipStyle}" Content="Tous"  GroupName="FleetFilter" IsChecked="True"/>
                <RadioButton x:Name="rdbtn_Disponibles" Style="{StaticResource FilterRadioChipStyle}" Content="Disponibles" GroupName="FleetFilter" Checked="rdbtn_Disponibles_Checked"/>
                <RadioButton x:Name="rdbtn_EnLocation" Style="{StaticResource FilterRadioChipStyle}" Content="En location" GroupName="FleetFilter" Checked="rdbtn_EnLocation_Checked"/>
                <RadioButton x:Name="rdbtn_EnMaintenance" Style="{StaticResource FilterRadioChipStyle}" Content="En maintenance" GroupName="FleetFilter" Checked="rdbtn_EnMaintenance_Checked"/>
                <RadioButton x:Name="rdbtn_Retires" Style="{StaticResource FilterRadioChipStyle}" Content="Retirés du service" GroupName="FleetFilter" Checked="rdbtn_Retires_Checked"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Total:" Style="{StaticResource SubHeaderTextStyle}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="69 véhicules" Foreground="{StaticResource TextPrimaryBrush}"
                           FontWeight="SemiBold" VerticalAlignment="Center" x:Name="txtblk_TotalCars"/>
            </StackPanel>
        </Grid>


        <!-- ============ Filter by field + value ============ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}"
        Padding="16,12" Margin="0,0,0,12" x:Name="FilterGird">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Field selector -->
                <TextBlock Grid.Column="0" Text="FILTRER PAR"
                   Style="{StaticResource FilterLabelStyle}"/>

                <!-- Value input -->
                <TextBox Grid.Column="2" Width="150" Style="{StaticResource AppTextBoxStyle}"
                         x:Name="txtbx_Filter" Visibility="Collapsed" TextChanged="txtbx_Filter_TextChanged"/>

                <ComboBox Grid.Column="2" Style="{StaticResource FilterComboStyle}" Height="43"
                    Width="150" Margin="0,0,16,0" Visibility="Collapsed" x:Name="CBx_BodyTypes"
                          SelectionChanged="CBx_BodyTypes_SelectionChanged">
                </ComboBox>

                <ComboBox Grid.Column="1" Style="{StaticResource FilterComboStyle}"
                  Width="150" Margin="0,0,16,0" x:Name="CBx_FilterBy">
                    <ComboBoxItem Content="Aucun filtre"/>
                    <ComboBoxItem Content="Immatriculation"/>
                    <ComboBoxItem Content="Marque"/>
                    <ComboBoxItem Content="Modèle"/>
                    <ComboBoxItem Content="Type"/>
                </ComboBox>

                <!-- Clear -->
                <Button Style="{StaticResource PrimaryButtonStyle}" Grid.Column="4" Width="100" Height="30" 
                        x:Name="btn_Clear" Click="btn_Clear_Click" Visibility="Hidden">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Effacer" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ============ List rows ============ -->
        <DataGrid x:Name="FleetGrid"
          Grid.Row="4"
          Style="{StaticResource AppDataGridStyle}"
          ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
          RowStyle="{StaticResource AppDataGridRowStyle}"  
          CellStyle="{StaticResource AppDataGridCellStyle}">

            <DataGrid.Columns>

                <!-- VEHICLE -->
                <DataGridTemplateColumn Header="VÉHICULE" Width="2.0*">
                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Car_FullName}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Plate}"
                                   Style="{StaticResource SubHeaderTextStyle}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- TYPE -->
                <DataGridTextColumn Header="TYPE"
                            Binding="{Binding BodyType}"
                            Width="1.0*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- SEATS -->
                <DataGridTextColumn Header="PLACES"
                            Binding="{Binding NumberOfSeats}"
                            Width="0.8*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- RATE/DAY -->
                <DataGridTextColumn Header="TARIF/JOUR"
                            Binding="{Binding DailyRentPrice, StringFormat='MAD {0:N0}'}"
                            Width="1.0*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- STATUS -->
                <DataGridTemplateColumn Header="STATUS" Width="1.0*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AppStatusPillStyle}">
                                <TextBlock Text="{Binding Status}"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ACTIONS -->
                <DataGridTemplateColumn Header="ACTIONS" Width="2.0*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Détails" x:Name="btn_Details"
                                Style="{StaticResource GhostButtonStyle}"
                                Margin="0,0,6,0" Click="btn_Details_Click"/>
                                <Button Content="Modifier" x:Name="btn_Edit"
                                Style="{StaticResource GhostButtonStyle}"
                                Margin="0,0,6,0" Click="btn_Edit_Click"/>
                                <Button Content="Supprimer" x:Name="btn_Delete"
                                Style="{StaticResource GhostButtonStyle}"
                                        Click="btn_Delete_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <Border x:Name="EmptyStatePanel" Grid.Row="4"
            Style="{StaticResource EmptyStateContainerStyle}" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <iconPacks:PackIconFontAwesome Kind="CarSolid" 
                               Width="24" Height="24" 
                               Foreground="{StaticResource PrimaryBrush}" 
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock Text="Aucun véhicule trouvé" Style="{StaticResource EmptyStateTitleStyle}"/>
                <TextBlock Text="Il n'y a aucun véhicule actif pour le moment. Ajoutez-en un pour commencer."
               Style="{StaticResource EmptyStateHintStyle}"/>
                <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0" MaxWidth="180" Click="btn_AddNewCar_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Plus"
                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                            Width="16" Height="16"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"/>
                        <TextBlock Text="Ajouter un véhicule" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>