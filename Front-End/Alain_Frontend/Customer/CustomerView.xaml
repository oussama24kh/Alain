<UserControl x:Class="project_03.Customer.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource DarkBgBrush}" Loaded="UserControl_Loaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header & Actions Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Customer Management" Style="{StaticResource HeaderTextStyle}"/>
                <TextBlock Text="Manage registered clients, contact information, and rental activity." Style="{StaticResource SubHeaderTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">

                <!-- Add Customer Button -->
                <Button x:Name="BtnAddCustomer" Height="36" Style="{StaticResource PrimaryButtonStyle}" Click="BtnAddCustomer_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="AccountPlus" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Ajouter un client" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Metric Summary Cards -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
            <!-- Total Customers Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Total Customers" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock x:Name="txtTotalCustomers" Style="{StaticResource HeaderTextStyle}" FontSize="24" Margin="0,6,0,0"
                                   Text="{Binding TotalCustomers, StringFormat={}{0:N2}, TargetNullValue=N/A, FallbackValue=N/A}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#2563EB" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="AccountGroup" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Active Rentals Card -->
            <Border Style="{StaticResource CardStyle}" Margin="6,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Active Rentals" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock x:Name="txtActiveRentals" Style="{StaticResource HeaderTextStyle}" FontSize="24" Margin="0,6,0,0"
                                   Text="{Binding ActiveRentals, StringFormat={}{0:N2}, TargetNullValue=N/A, FallbackValue=N/A}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="{StaticResource GreenBrush}" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Key" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                </Grid>
            </Border>

            <!-- New This Month Card -->
            <Border Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="New This Month" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock x:Name="txtNewCustomerCount" Style="{StaticResource HeaderTextStyle}" FontSize="24" Margin="0,6,0,0"
                                   Text="{Binding NewCustomers, StringFormat={}{0:N2}, TargetNullValue=N/A, FallbackValue=N/A}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="{StaticResource AmberBrush}" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="AccountPlus" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                </Grid>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}"
        Padding="16,12" Margin="0,0,0,12" x:Name="FilterGird">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Field selector -->
                <TextBlock Grid.Column="0" Text="FILTRER PAR"
                   Style="{StaticResource FilterLabelStyle}"/>

                <!-- Value input -->
                <TextBox Grid.Column="2" Width="150" Style="{StaticResource AppTextBoxStyle}"
                         x:Name="txtbx_Filter" Visibility="Collapsed" />

                <ComboBox Grid.Column="2" Style="{StaticResource FilterComboStyle}" Height="43"
                    Width="150" Margin="0,0,16,0" Visibility="Collapsed" x:Name="CBx_Nationality">
                    
                </ComboBox>

                <ComboBox Grid.Column="1" Style="{StaticResource FilterComboStyle}"
                  Width="150" Margin="0,0,16,0" x:Name="CBx_FilterBy">
                    <ComboBoxItem Content="Aucun filtre"/>
                    <ComboBoxItem Content="Client"/>
                    <ComboBoxItem Content="Numéro National"/>
                    <ComboBoxItem Content="Téléphone"/>
                    <ComboBoxItem Content="Nationalité"/>
                </ComboBox>

                <!-- Clear -->
                <Button Style="{StaticResource PrimaryButtonStyle}" Grid.Column="4" Width="100" Height="30" 
                        x:Name="btn_Clear" Visibility="Hidden" Click="btn_Clear_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Effacer" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>


        <!-- 3. Customers DataGrid (Without Border Container, directly matching FleetGrid) -->
        <DataGrid x:Name="CustomersGrid"
                  Grid.Row="4"
                  Style="{StaticResource AppDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                  RowStyle="{StaticResource AppDataGridRowStyle}"  
                  CellStyle="{StaticResource AppDataGridCellStyle}">

            <DataGrid.Columns>

                <!-- CLIENT (Full Name + CIN) -->
                <DataGridTemplateColumn Header="CLIENT" Width="2.0*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding FullName}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding NationalNo}"
                                           Style="{StaticResource SubHeaderTextStyle}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- PHONE -->
                <DataGridTextColumn Header="TÉLÉPHONE"
                                    Binding="{Binding Phone}"
                                    Width="1.2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- DRIVER'S LICENSE -->
                <!--<DataGridTextColumn Header="PERMIS"
                                    Binding="{Binding LicenseNumber}"
                                    Width="1.2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>-->

                <!-- TOTAL RENTALS -->
                <DataGridTextColumn Header="LOCATIONS"
                                    Binding="{Binding TotalRentals}"
                                    Width="0.8*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="NATIONALITÉ"
                    Binding="{Binding Nationality}"
                    Width="1.2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- ACTIONS -->
                <DataGridTemplateColumn Header="ACTIONS" Width="2.0*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Détails" x:Name="btn_Details"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="0,0,6,0" Click="btn_Details_Click"/>
                                <Button Content="Modifier" x:Name="btn_Edit"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="0,0,6,0" Click="btn_Edit_Click"/>
                                <Button Content="Supprimer" x:Name="btn_Delete"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Click="btn_Delete_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <Border x:Name="EmptyStatePanel"
        Grid.Row="4"
        Style="{StaticResource CardStyle}" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                <iconPacks:PackIconMaterial Kind="AccountOff" 
                                    Width="32" Height="32" 
                                    Foreground="{StaticResource PrimaryBrush}" 
                                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Aucun client trouvé" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Center"/>
                <TextBlock Text="Il n'y a aucun client enregistré pour le moment. Ajoutez-en un pour commencer."
                   Style="{StaticResource SubHeaderTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0" Width="180" Click="BtnAddCustomer_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" >
                        <iconPacks:PackIconMaterial Kind="Plus"
                                            Foreground="White"
                                            Width="14" Height="14"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"/>
                        <TextBlock Text="Ajouter un client" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>