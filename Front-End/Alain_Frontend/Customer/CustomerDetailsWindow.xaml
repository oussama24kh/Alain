<Window x:Class="project_03.Customer.CustomerDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:project_03.Customer.Controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Détails du Client" Height="360" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource DarkBgBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Embedded UserControl -->
        <local:CustomerDetailsControl x:Name="CustomerDetailsControl" Grid.Row="0" Margin="0,0,0,16"/>

        <!-- Action Bar -->
        <Button Grid.Row="1" x:Name="BtnClose" Click="BtnClose_Click" Width="105" Height="36" HorizontalAlignment="Right"
                Background="{StaticResource BorderBrushSoft}" Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource PrimaryButtonStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Fermer" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>