<UserControl x:Class="project_03.Customer.Controls.CustomerDetailsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent" MinWidth="540">

    <Border Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Card Header (Name & National ID) -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtFullName" Text="N/A" Style="{StaticResource HeaderTextStyle}" FontSize="18"/>
                    <TextBlock x:Name="TxtNationalNumber" Text="CIN: N/A" Style="{StaticResource SubHeaderTextStyle}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Rentals Counter Pill -->
                <Border Grid.Column="1" Style="{StaticResource AppStatusPillStyle}" Background="{StaticResource GreenBrush}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CarKey" Width="12" Height="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TxtTotalRentals" Text="N/A" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Divider Line -->
            <Separator Grid.Row="1" Background="{StaticResource BorderBrushSoft}" Margin="0,0,0,16"/>

            <!-- Details Grid (2 Columns) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0">
                    <!-- Email -->
                    <DockPanel Margin="0,0,0,12">
                        <iconPacks:PackIconMaterial Kind="Email" Width="14" Height="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Email:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Width="100"/>
                        <TextBlock x:Name="TxtEmail" Text="N/A" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- Phone -->
                    <DockPanel Margin="0,0,0,12">
                        <iconPacks:PackIconMaterial Kind="Phone" Width="14" Height="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Téléphone:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Width="100"/>
                        <TextBlock x:Name="TxtPhone" Text="N/A" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Medium"/>
                    </DockPanel>

                    <!-- Date of Birth -->
                    <DockPanel Margin="0,0,0,12">
                        <iconPacks:PackIconMaterial Kind="Calendar" Width="14" Height="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Date Naissance:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Width="100"/>
                        <TextBlock x:Name="TxtDateOfBirth" Text="N/A" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Medium"/>
                    </DockPanel>
                </StackPanel>

                <!-- Right Column -->
                <StackPanel Grid.Column="2">
                    <!-- National Number / CIN -->
                    <DockPanel Margin="0,0,0,12">
                        <iconPacks:PackIconMaterial Kind="CardAccountDetails" Width="14" Height="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="N° National (CIN):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Width="105"/>
                        <TextBlock x:Name="TxtNationalID" Text="N/A" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Medium"/>
                    </DockPanel>

                    <!-- Nationality -->
                    <DockPanel Margin="0,0,0,12">
                        <iconPacks:PackIconMaterial Kind="Flag" Width="14" Height="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Nationalité:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Width="105"/>
                        <TextBlock x:Name="TxtNationality" Text="N/A" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Medium"/>
                    </DockPanel>

                    <!-- Address -->
                    <DockPanel Margin="0,0,0,12">
                        <iconPacks:PackIconMaterial Kind="MapMarker" Width="14" Height="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Adresse:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Width="105"/>
                        <TextBlock x:Name="TxtAddress" Text="N/A" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Medium" TextWrapping="Wrap"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>