<Window x:Class="project_03.Payment.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Reçu de Paiement" Height="480" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource DarkBgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Header -->
            <RowDefinition Height="*"/>
            <!-- Main Horizontal Content Card -->
            <RowDefinition Height="Auto"/>
            <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="8" Background="#1E293B" Margin="0,0,12,0">
                    <iconPacks:PackIconMaterial Kind="Receipt" Width="20" Height="20" 
                                                Foreground="{StaticResource PrimaryBrush}" 
                                                VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="REÇU DE PAIEMENT" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Agence de Location de Voitures"
                               Style="{StaticResource SubHeaderTextStyle}"/>
                </StackPanel>
            </StackPanel>

            <!-- Status Pill on Right -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#10B981" CornerRadius="4" Padding="14,6">
                <TextBlock Text="PAYÉ" Foreground="White" FontSize="12" FontWeight="Bold"/>
            </Border>
        </Grid>

        <!-- ============ Main Horizontal Card Details ============ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24" VerticalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 1: Contract & Customer Info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="FACTURE / CONTRAT" Style="{StaticResource SubHeaderTextStyle}" FontSize="11"/>
                        <TextBlock x:Name="TxtInvoiceNumber" Text="N/A" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="CLIENT" Style="{StaticResource SubHeaderTextStyle}" FontSize="11"/>
                        <TextBlock x:Name="TxtCustomerName" Text="N/A" FontSize="15" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Vertical Divider -->
                <Rectangle Grid.Column="1" Width="1" Fill="#1E293B" Margin="24,0"/>

                <!-- Column 2: Vehicle, Duration & Date -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="VÉHICULE &amp; DURÉE" Style="{StaticResource SubHeaderTextStyle}" FontSize="11"/>
                        <TextBlock x:Name="TxtVehicleInfo" Text="N/A" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="TxtRentalDays" Text="Durée : N/A" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                    </StackPanel>

                    <Grid>
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="DATE DE PAIEMENT" Style="{StaticResource SubHeaderTextStyle}" FontSize="11"/>
                            <TextBlock x:Name="TxtPaymentDate" Text="N/A" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="MONTANT" Style="{StaticResource SubHeaderTextStyle}" FontSize="11" TextAlignment="Right"/>
                            <TextBlock x:Name="TxtAmount" Text="N/A" FontSize="16" FontWeight="Bold" Foreground="{StaticResource GreenBrush}" Margin="0,2,0,0" TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Action Buttons ============ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <!--<Button Content="Imprimer / PDF" Style="{StaticResource GhostButtonStyle}" Width="130" Height="36" Margin="0,0,10,0" Click="BtnPrint_Click"/>-->
            <Button Content="Fermer" Style="{StaticResource PrimaryButtonStyle}" Width="100" Height="36" Click="btn_Close_Click"/>
        </StackPanel>
    </Grid>
</Window>