<Window x:Class="project_03.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Connexion — RentFlow Rentals"
        Height="620" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource DarkBgBrush}">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Logo Area -->
            <RowDefinition Height="*"/>
            <!-- Login Form Card -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ============ Empty Logo Space ============ -->
        <Border x:Name="LogoContainer"
                Grid.Row="0"
                Height="90"
                Margin="0,8,0,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent">
            <!-- Place your <Image Source="..." Stretch="Uniform"/> here -->
        </Border>

        <!-- ============ Login Card ============ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="26">
            <StackPanel VerticalAlignment="Center">
                <!-- Title -->
                <TextBlock Text="Connexion"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Accédez à votre espace de gestion"
                           Style="{StaticResource SubHeaderTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,22"/>

                <!-- Username -->
                <TextBlock Text="IDENTIFIANT"
                           Style="{StaticResource SettingsLabelStyle}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="txtBx_Username"
                         Style="{StaticResource AppTextBoxStyle}"
                         FontFamily="Consolas"
                         Margin="0,0,0,16"
                         KeyDown="Input_KeyDown"/>

                <!-- Password -->
                <TextBlock Text="MOT DE PASSE"
                           Style="{StaticResource SettingsLabelStyle}"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="pwdBx_Password"
                             Style="{StaticResource AppPasswordBoxStyle}"
                             Margin="0,0,0,12"
                             KeyDown="Input_KeyDown"/>

                <!-- Remember Me -->
                <!--<CheckBox x:Name="chk_RememberMe"
                          Content="Se souvenir de moi"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="12"
                          Cursor="Hand"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,18"/>-->

                <!-- Inline Error Message -->
                <Border x:Name="ErrorBanner"
                        Background="#2A1215"
                        BorderBrush="#EF4444"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="AlertCircleOutline"
                                                    Width="16" Height="16"
                                                    Foreground="#EF4444"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtError"
                                   Foreground="#FCA5A5"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Submit Button -->
                <Button x:Name="BtnLogin"
                        Content="Se connecter"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="40"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Click="BtnLogin_Click"/>
            </StackPanel>
        </Border>

        <!-- ============ Footer ============ -->
        <TextBlock Grid.Row="2"
                   Text="© 2026 RentFlow Rentals — Tous droits réservés"
                   Style="{StaticResource SubHeaderTextStyle}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,18,0,0"/>
    </Grid>
</Window>