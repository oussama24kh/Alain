<UserControl x:Class="project_03.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Loaded="UserControl_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <!-- HEADER / WELCOME SECTION -->
            <Grid Margin="0,0,0,20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Tableau de Bord" Style="{StaticResource HeaderTextStyle}" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Bienvenue dans votre système de gestion de location de véhicules." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Current Date Indicator -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1E293B" CornerRadius="6" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Calendar" Width="14" Height="14" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="txtCurrentDate" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- KPI METRIC CARDS (Top Row) -->
            <UniformGrid Columns="4" Margin="0,0,0,24">

                <!-- Card 1: Active Rentals -->
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Locations Actives" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <Border Width="32" Height="32" CornerRadius="6" Background="#1E293B" HorizontalAlignment="Right">
                                <iconPacks:PackIconMaterial Kind="CarKey" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="txtActiveRentalsCount" Text="N/A" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Available Cars -->
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="6,0,6,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Véhicules Disponibles" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <Border Width="32" Height="32" CornerRadius="6" Background="#1E293B" HorizontalAlignment="Right">
                                <iconPacks:PackIconMaterial Kind="Car" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="txtAvailableCarsCount" Text="N/A" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="txtAvailableCarsPercentage" Text="" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Monthly Revenue -->
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="6,0,6,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Revenu du Mois" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Width="32" Height="32" CornerRadius="6" Background="#1E293B" HorizontalAlignment="Right">
                                <iconPacks:PackIconMaterial Kind="CashMultiple" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="txtMonthlyRevenue" Text="N/A" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="Ce mois-ci" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: -->
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="12,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Locations en Retard" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" 
                                       FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Border Width="32" Height="32" CornerRadius="6" Background="#1E293B" HorizontalAlignment="Right">
                                <iconPacks:PackIconMaterial Kind="ClockAlertOutline" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#EF4444"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="txtOverdueRentalsCount" Text="N/A" FontSize="22" FontWeight="Bold" Foreground="#EF4444"/>
                        <TextBlock Text="Dépassement de date" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- QUICK ACTIONS SHORTCUTS -->
            <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Actions Rapides" Style="{StaticResource HeaderTextStyle}" FontSize="14" Margin="0,0,0,14"/>
                    <WrapPanel>
                        <Button x:Name="BtnNewRental" Content="Nouveau Contrat" Width="150" Height="36" Margin="0,0,12,0" Style="{StaticResource PrimaryButtonStyle}" Click="BtnNewRental_Click"/>
                        <Button x:Name="BtnAddCustomer" Content="Ajouter Client" Width="140" Height="36" Margin="0,0,12,0" Style="{StaticResource PrimaryButtonStyle}" Click="BtnAddCustomer_Click"/>
                        <Button x:Name="BtnAddCar" Content="Ajouter Véhicule" Width="140" Height="36" Margin="0,0,12,0" Style="{StaticResource PrimaryButtonStyle}" Click="BtnAddCar_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- RECENT ACTIVE CONTRACTS DATAGRID -->
            <Border Style="{StaticResource CardStyle}" Padding="20" x:Name="RentalData">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Locations En Cours Récentes" Style="{StaticResource HeaderTextStyle}" FontSize="14" VerticalAlignment="Center"/>
                        <Button x:Name="BtnViewAllRentals" Content="Voir Tout" HorizontalAlignment="Right" Width="80" Height="28" Style="{StaticResource GhostButtonStyle}" Click="BtnViewAllRentals_Click"/>
                    </Grid>

                    <DataGrid x:Name="RentalsDataGrid"
                  Grid.Row="4" Style="{StaticResource AppDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                  RowStyle="{StaticResource AppDataGridRowStyle}"  
                  CellStyle="{StaticResource AppDataGridCellStyle}">

                        <DataGrid.Columns>

                            <!-- RENTAL ID / REF -->
                            <DataGridTextColumn Header="RÉFÉRENCE"
                    Binding="{Binding RentalCode}"
                    Width="1.0*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- VEHICLE -->
                            <DataGridTemplateColumn Header="VÉHICULE" Width="1.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CarFullName}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding CarPlate}"
                                           Style="{StaticResource SubHeaderTextStyle}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- CLIENT (Full Name + CIN) -->
                            <DataGridTemplateColumn Header="CLIENT" Width="1.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CustomerName}"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding NationalNo}"
                                            Style="{StaticResource SubHeaderTextStyle}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- RENTAL PERIOD / DATES -->
                            <DataGridTemplateColumn Header="PÉRIODE" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RentalPeriodText}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="12"/>
                                            <TextBlock Text="{Binding DaysCount, StringFormat='({0} jours)'}"
                                           Style="{StaticResource SubHeaderTextStyle}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- STATUS -->
                            <DataGridTemplateColumn Header="STATUT" Width="1.0*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource AppStatusPillStyle}">
                                            <TextBlock Text="{Binding Status}"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ACTIONS -->
                            <DataGridTemplateColumn Header="ACTIONS" Width="2.0*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Détails" x:Name="btnDetails" Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0" Click="btnDetails_Click"/>
                                            <Button Content="Modifier" x:Name="btnEdit" Style="{StaticResource DisableWhenCanceledButtonStyle}" Margin="0,0,6,0" Click="btnEdit_Click"/>
                                            <Button Content="Clôturer" x:Name="btnCloturer" Style="{StaticResource DisableWhenCanceledButtonStyle}"  Click="btnCloturer_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border x:Name="DashboardEmptyStatePanel" Style="{StaticResource CardStyle}" Visibility="Collapsed" 
                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,30,0,30">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                    <iconPacks:PackIconMaterial Kind="ViewDashboardOutline" 
                                    Width="36" Height="36" 
                                    Foreground="{StaticResource PrimaryBrush}" 
                                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Tableau de bord vide" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Aucune donnée récente n'est disponible pour le moment. Commencez par créer votre première location."
                   Style="{StaticResource SubHeaderTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,16" TextAlignment="Center"/>
                    <Button x:Name="BtnEmptyNewRental" Style="{StaticResource PrimaryButtonStyle}" Width="180" Height="36" Click="BtnNewRental_Click">
                        <!-- Click="BtnNewRental_Click"-->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="Plus"
                                            Foreground="White"
                                            Width="14" Height="14"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"/>
                            <TextBlock Text="Nouvelle Location" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>