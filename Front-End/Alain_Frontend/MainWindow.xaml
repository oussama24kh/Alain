<Window x:Class="project_03.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Alain Car"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="900" Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource DarkBgBrush}" Closed="Window_Closed">
    

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="60" MaxWidth="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================ SIDEBAR ============================ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0"
            Orientation="Horizontal"
            Margin="8,16"
            VerticalAlignment="Center">

                    <!--<Image Source="/Styles/Images/ALAIN_LOGO.png"
                    Width="40" Height="40" Stretch="Uniform" Margin="0,0,10,0"/>-->

                    <TextBlock Text="Alain Car" Foreground="{StaticResource TextPrimaryBrush}"
                    FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>

                </StackPanel>

                <!-- Nav -->
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                 x:Name="rdbtn_DashBoard" >
                        <RadioButton.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ViewDashboardOutline"
                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                    Width="20" Height="20"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"/>
                                    <TextBlock Text="Tableau de bord" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </RadioButton.ContentTemplate>
                    </RadioButton>
                    
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                 x:Name="rdbtn_Fleet" Checked="rdbtn_Fleet_Checked" Click="rdbtn_Fleet_Checked">
                        <RadioButton.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconFontAwesome Kind="CarSideSolid"
                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                    Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Véhicules" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </RadioButton.ContentTemplate>

                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                 x:Name="rdbtn_Rentals" Checked="rdbtn_Rentals_Checked">

                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FileDocumentOutline"
                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                    Width="20" Height="20"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"/>

                            <TextBlock Text="Locations" VerticalAlignment="Center"/>

                        </StackPanel>

                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                 x:Name="rdbtn_Clients" Checked="rdbtn_Clients_Checked">

                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="AccountMultipleOutline"
                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                    Width="20" Height="20"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"/>

                            <TextBlock Text="Clients" VerticalAlignment="Center"/>

                        </StackPanel>

                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                 x:Name="rdbtn_Payments" Checked="rdbtn_Payments_Checked">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Finance"
                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                    Width="20" Height="20"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"/>
                            <TextBlock Text="Paiements" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                x:Name="rdbtn_Setting" Checked="rdbtn_Setting_Checked">

                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CogOutline"
                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                    Width="20" Height="20"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"/>

                            <TextBlock Text="Paramètres" VerticalAlignment="Center"/>

                        </StackPanel>

                    </RadioButton>
                </StackPanel>

                <Button Grid.Row="2" Style="{StaticResource LogoutButtonStyle}" Click="btn_Logout_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="LogoutVariant"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Width="20" Height="20"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"/>
                        <TextBlock Text="Déconnexion" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ============================ MAIN ============================ -->
        <ContentControl Grid.Column="1" x:Name="MainContent"/>
    </Grid>
</Window>