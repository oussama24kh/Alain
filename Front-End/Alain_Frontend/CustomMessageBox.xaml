<Window x:Class="project_03.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Message" Height="220" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Style="{StaticResource CardStyle}" 
        BorderBrush="{StaticResource BorderBrushSoft}" 
        BorderThickness="1" 
        Padding="24"
        Margin="6">
        <!-- Soft DropShadow Effect -->
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- FIXED: Changed from "*" to "Auto" so it scales dynamically -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Title -->
            <TextBlock x:Name="TxtTitle" Grid.Row="0" Text="Notification" Style="{StaticResource HeaderTextStyle}" FontSize="16" Margin="0,0,0,16"/>

            <!-- Message Body + Icon -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MaxWidth="380"/>
                    <!-- FIXED: Added MaxWidth to force text wrapping within bounds -->
                </Grid.ColumnDefinitions>

                <!-- Icon Container -->
                <Border x:Name="IconBorder" Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#1E293B" Margin="0,0,16,0" VerticalAlignment="Top">
                    <iconPacks:PackIconMaterial x:Name="MsgIcon" Kind="Information" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                </Border>

                <!-- Message Text -->
                <TextBlock x:Name="TxtMessage" Grid.Column="1" Text="Message details go here." Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" 
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Cancel / No Button -->
                <Button x:Name="BtnCancel" Click="BtnCancel_Click" Width="110" Height="34" Margin="0,0,10,0" Visibility="Collapsed"
                    Background="{StaticResource BorderBrushSoft}" Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial x:Name="SecondaryIcon" Kind="Close" 
                        Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtCancel" Text="Cancel" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- OK / Yes Button -->
                <Button x:Name="BtnOk" Click="BtnOk_Click" Width="110" Height="34" Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial x:Name="OkIcon" Kind="Check" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtOk" Text="OK" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>