<UserControl x:Class="project_03.User.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource DarkBgBrush}" Loaded="UserControl_Loaded">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- KPI cards (4) -->
            <RowDefinition Height="*"/>
            <!-- Body: Users (main) + Company/Security (side) -->
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Settings" Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Manage users, workspace and operational metrics"
                       Style="{StaticResource SubHeaderTextStyle}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- ============ Operational KPI Cards ============ -->
        <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,12">

            <!-- Card 1: Monthly Revenue -->
            <Border Style="{StaticResource CardStyle}" Margin="8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CA MENSUEL" Style="{StaticResource SubHeaderTextStyle}"/>
                        <iconPacks:PackIconMaterial Grid.Column="1" Kind="CashMultiple" Width="18" Height="18" 
                                                    Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="txtMonthRevenue" Text="-" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource GreenBrush}" Margin="0,6,0,0"/>
                    <TextBlock Text="Revenus encaissés ce mois"
                               Style="{StaticResource SubHeaderTextStyle}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Active Rentals -->
            <Border Style="{StaticResource CardStyle}" Margin="8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="LOCATIONS EN COURS" Style="{StaticResource SubHeaderTextStyle}"/>
                        <iconPacks:PackIconMaterial Grid.Column="1" Kind="CarKey" Width="18" Height="18" 
                                                    Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="txtRentedVehicles" Text="-" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                    <TextBlock Text="Véhicules actuellement loués"
                               Style="{StaticResource SubHeaderTextStyle}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Fleet Status -->
            <Border Style="{StaticResource CardStyle}" Margin="8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="FLOTTE DISPONIBLE" Style="{StaticResource SubHeaderTextStyle}"/>
                        <iconPacks:PackIconMaterial Grid.Column="1" Kind="Car" Width="18" Height="18" 
                                                    Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="txtAvailableVehicles" Text="-" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource AmberBrush}" Margin="0,6,0,0"/>
                    <TextBlock Text="Prêts pour location"
                               Style="{StaticResource SubHeaderTextStyle}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Settlement Rate -->
            <Border Style="{StaticResource CardStyle}" Margin="8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TAUX DE RÈGLEMENT" Style="{StaticResource SubHeaderTextStyle}"/>
                        <iconPacks:PackIconMaterial Grid.Column="1" Kind="CheckCircleOutline" Width="18" Height="18" 
                                                    Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="94.2%" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                    <TextBlock Text="Factures soldées à temps"
                               Style="{StaticResource SubHeaderTextStyle}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- ============ Body: 2* main / 1* side ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== MAIN COLUMN ==================== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Utilisateurs" Style="{StaticResource HeaderTextStyle}"/>
                            <TextBlock Text="-" x:Name="txtStatistics"
                                       Style="{StaticResource SettingsHintStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="btn_AddNewUser" Click="btn_AddNewUser_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="AccountPlus" 
                                    Width="16" Height="16" 
                                    Margin="0,0,8,0" 
                                    VerticalAlignment="Center"/>
                                <TextBlock Text="Inviter un utilisateur" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <DataGrid x:Name="UsersGrid"
                    Grid.Row="1"
                    Style="{StaticResource AppDataGridStyle}"
                    ColumnHeaderStyle="{StaticResource AppDataGridColumnHeaderStyle}"
                    RowStyle="{StaticResource AppDataGridRowStyle}"
                    CellStyle="{StaticResource AppDataGridCellStyle}">
                        <DataGrid.Columns>
                            <!-- FullName + Email -->
                            <DataGridTemplateColumn Header="UTILISATEUR" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Email}"
                                   Style="{StaticResource SubHeaderTextStyle}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Username -->
                            <DataGridTextColumn Header="IDENTIFIANT"
                            Binding="{Binding UserName}"
                            Width="1.2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Role -->
                            <DataGridTemplateColumn Header="RÔLE" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RolePillStyle}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Role}"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="ACTIONS" Width="1.4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Modifier"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Margin="0,0,6,0"
                                            Click="BtnEditUser_Click"/>

                                            <Button Click="BtnToggleBanUser_Click"
                                            ToolTip="Activer ou bannir cet utilisateur">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Foreground" Value="#34D399"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <iconPacks:PackIconMaterial Width="14" Height="14"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center">
                                                        <iconPacks:PackIconMaterial.Style>
                                                            <Style TargetType="iconPacks:PackIconMaterial">
                                                                <Setter Property="Kind" Value="AccountCancel"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                        <Setter Property="Kind" Value="AccountCheck"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </iconPacks:PackIconMaterial.Style>
                                                    </iconPacks:PackIconMaterial>

                                                    <TextBlock VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Bannir"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                        <Setter Property="Text" Value="Débannir"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ==================== SIDE COLUMN ==================== -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ===== COMPANY ===== -->
                    <Border Style="{StaticResource CardStyle}" Margin="8,0,0,8">
                        <StackPanel>
                            <!-- Title + Edit -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Agence"
                                           Style="{StaticResource HeaderTextStyle}"/>
                                <Button Grid.Column="1" Content="Modifier" Click="Btn_EditCompanyInfo_Click"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="10,4" FontSize="11"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Name -->
                            <TextBlock Text="NOM" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBlock Text="-" x:Name="txtName"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <!-- Email -->
                            <TextBlock Text="E-MAIL" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBlock Text="-" x:Name="txtEmail"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14"
                                       Margin="0,0,0,12"/>

                            <!-- Phone -->
                            <TextBlock Text="TÉLÉPHONE" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBlock Text="-" x:Name="txtPhone"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14"
                                       Margin="0,0,0,12"/>

                            <!-- Address -->
                            <TextBlock Text="ADRESSE" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBlock Text="-" x:Name="txtAddress"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== SECURITY ===== -->
                    <Border Style="{StaticResource CardStyle}" Margin="8,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Security" Style="{StaticResource HeaderTextStyle}"
                                       Margin="0,0,0,12"/>

                            <Grid Style="{StaticResource SettingsToggleRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <Button Content="Change Password" Click="btn_change_Password"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>