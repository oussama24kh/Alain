<Window x:Class="project_03.User.AddEditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Utilisateur" Height="560" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource DarkBgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Form Card -->
            <RowDefinition Height="Auto"/>
            <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Border Width="42" Height="42" CornerRadius="10" Background="#1E293B" Margin="0,0,12,0">
                <iconPacks:PackIconMaterial x:Name="HeaderIcon" Kind="AccountPlus" Width="20" Height="20"
                                            Foreground="{StaticResource PrimaryBrush}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtWindowTitle" Text="Inviter un utilisateur"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="TxtWindowSubtitle" Text="Créer un accès pour un membre de l'équipe"
                           Style="{StaticResource SubHeaderTextStyle}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ============ Form Card ============ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20">
            <StackPanel>
                <!-- First Name & Last Name (2 columns) -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PRÉNOM *" Style="{StaticResource SettingsLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtBx_FirstName" Style="{StaticResource AppTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="NOM *" Style="{StaticResource SettingsLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtBx_LastName" Style="{StaticResource AppTextBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Username & Role (2 columns) -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="IDENTIFIANT *" Style="{StaticResource SettingsLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtBx_Username" Style="{StaticResource AppTextBoxStyle}" FontFamily="Consolas"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="RÔLE *" Style="{StaticResource SettingsLabelStyle}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbRole" Style="{StaticResource FilterComboStyle}" SelectedIndex="1">
                            <ComboBoxItem Content="Administrateur"/>
                            <ComboBoxItem Content="Utilisateur" IsSelected="True"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Email -->
                <TextBlock Text="ADRESSE E-MAIL *" Style="{StaticResource SettingsLabelStyle}" Margin="0,0,0,4"/>
                <TextBox x:Name="txtBx_Email" Style="{StaticResource AppTextBoxStyle}" Margin="0,0,0,14"/>

                <!-- Password -->
                <StackPanel x:Name="PasswordSection">
                    <TextBlock x:Name="TxtPasswordLabel" Text="MOT DE PASSE *"
                               Style="{StaticResource SettingsLabelStyle}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="pwdBx_Password" Style="{StaticResource AppPasswordBoxStyle}"/>
                    <TextBlock x:Name="TxtPasswordHint"
                               Text="Laissez vide pour conserver le mot de passe actuel."
                               Style="{StaticResource SettingsHintStyle}"
                               Visibility="Collapsed" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Inline Validation Error -->
                <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12"
                           Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- ============ Footer Actions ============ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Annuler" Style="{StaticResource GhostButtonStyle}"
                    Width="100" Height="36" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}"
                    Width="120" Height="36" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>