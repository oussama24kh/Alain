<Window x:Class="project_03.User.EditCompanyWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Informations de l'entreprise"
        Height="470" Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource DarkBgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Horizontal Form Card -->
            <RowDefinition Height="Auto"/>
            <!-- Footer Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Informations de l'entreprise"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="20"
                       FontWeight="Bold"/>
            <TextBlock Text="Modifiez les coordonnées de l'entreprise"
                       Style="{StaticResource SubHeaderTextStyle}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Horizontal Form Card -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="22">
            <StackPanel>
                <!-- Row 1: Name (Left) | Email (Right) -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="NOM *"
                                   Style="{StaticResource SettingsLabelStyle}"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="txtBx_Name"
                                 Style="{StaticResource AppTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="E-MAIL *"
                                   Style="{StaticResource SettingsLabelStyle}"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="txtBx_Email"
                                 Style="{StaticResource AppTextBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Phone (Left) | City (Right) -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TÉLÉPHONE *"
                                   Style="{StaticResource SettingsLabelStyle}"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="txtBx_Phone"
                                 Style="{StaticResource AppTextBoxStyle}"
                                 FontFamily="Consolas"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="VILLE *"
                                   Style="{StaticResource SettingsLabelStyle}"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="txtBx_City"
                                 Style="{StaticResource AppTextBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Row 3: Address (Full Width) -->
                <StackPanel>
                    <TextBlock Text="ADRESSE *"
                               Style="{StaticResource SettingsLabelStyle}"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="txtBx_Address"
                             Style="{StaticResource AppTextBoxStyle}"/>
                </StackPanel>

                <!-- Inline Validation Error -->
                <Border x:Name="ErrorBanner"
                        Background="#2A1215"
                        BorderBrush="#EF4444"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,14,0,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="AlertCircleOutline"
                                                    Width="16" Height="16"
                                                    Foreground="#EF4444"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtError"
                                   Foreground="#FCA5A5"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Annuler"
                    Style="{StaticResource GhostButtonStyle}"
                    Padding="16,8"
                    Margin="0,0,10,0"
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave"
                    Content="Enregistrer"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="20,8"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>