<Window x:Class="project_03.Rental.AddEditRentalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:customerNamespace="clr-namespace:project_03.Customer.Controls"
        xmlns:carNamespace="clr-namespace:project_03.Car.Controls"
        xmlns:rentalNamespace="clr-namespace:project_03.Rental.Controls"
        Title="Gestion de Location" Height="650" Width="760" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None" Loaded="Window_Loaded"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- Sleek TextBox Style -->
        <Style TargetType="TextBox" x:Key="SleekTextBoxStyle">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark Theme TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="0,0,10,0" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource DarkBgBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="24">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Top Toolbar -->
                <RowDefinition Height="Auto"/>
                <!-- Subtitle -->
                <RowDefinition Height="*"/>
                <!-- TabControl Container -->
                <RowDefinition Height="Auto"/>
                <!-- Footer Buttons -->
            </Grid.RowDefinitions>

            <!-- TOP TOOLBAR -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Toolbar_MouseLeftButtonDown" Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtTitle" Text="Nouveau Contrat de Location" 
                           Foreground="{StaticResource TextPrimaryBrush}" 
                           FontSize="18" FontWeight="Bold" 
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="✕" Width="28" Height="28"
                        Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="BtnCancel_Click" HorizontalAlignment="Right">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- SUBTITLE -->
            <TextBlock Grid.Row="1" Text="Sélectionnez le véhicule, le client et définissez les termes du contrat" 
                       Foreground="{StaticResource TextSecondaryBrush}" 
                       FontSize="12" Margin="0,4,0,16"/>

            <!-- TAB CONTROL -->
            <TabControl x:Name="tabControl" Grid.Row="2" Background="Transparent" BorderThickness="0">

                <!-- ================= TAB 1: VEHICLE SEARCH ================= -->
                <TabItem x:Name="tab_Car">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Car" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Véhicule" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <!-- Embedded Car Search Control -->
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                        <carNamespace:CarSearchControl x:Name="carSearchControl"/>
                    </Border>
                </TabItem>

                <!-- ================= TAB 2: CUSTOMER SEARCH ================= -->
                <TabItem x:Name="tab_Customer">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Account" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Client" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <!-- Embedded Customer Search Control -->
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                        <customerNamespace:CustomerSearchControl x:Name="customerSearchControl"/>
                    </Border>
                </TabItem>

                <!-- ================= TAB 3: RENTAL INFO ================= -->
                <TabItem x:Name="tab_Contrat">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FileDocument" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Contrat" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                        <rentalNamespace:RentalInfoControl x:Name="RentalInfoControl"/>
                    </Border>
                </TabItem>
                
            </TabControl>

            <!-- FOOTER BUTTONS -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Annuler" Width="100" Height="38" Margin="0,0,10,0"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="BtnCancel_Click"/>
                <Button Content="Enregistrer le Contrat" Width="170" Height="38"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White" FontWeight="SemiBold"
                        Cursor="Hand" Click="BtnSave_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="ContentSave" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</Window>