<UserControl x:Class="project_03.Rental.Controls.RentalInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinHeight="380"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent" MinWidth="500" Loaded="UserControl_Loaded">

    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="20">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            
            <!-- Row 0, Left: Contract Reference (Converted to TextBlock) -->
            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Référence Contrat" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Border Background="#0B1220" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" Height="38" Padding="12,0">
                    <TextBlock x:Name="txtContractRef" Text="N/A" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Statut du Contrat" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="cbStatus" Height="38" Style="{StaticResource FilterComboStyle}" Width="NaN" IsEnabled="False">
                    <ComboBoxItem Content="En location" IsSelected="True"/>
                    <!--<ComboBoxItem Content="Terminee"/>-->
                    <ComboBoxItem Content="Annulee"/>
                </ComboBox>
            </StackPanel>


            <!-- Row 1, Left: Start Date -->
            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="Date de Début" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DatePicker x:Name="dpStartDate" Height="38" Style="{StaticResource AppDatePickerStyle}" Focusable="False"/>
            </StackPanel>

            <!-- Row 1, Right: End Date -->
            <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="Date de Fin" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DatePicker x:Name="dpEndDate" Height="38" Style="{StaticResource AppDatePickerStyle}" Focusable="False"/>
            </StackPanel>

            <!-- Row 2, Left: Total Price (Calculated) -->
            <StackPanel Grid.Column="2" Grid.Row="2">
                <TextBlock Text="Prix Total (DH)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtTotalPrice" Height="38" Margin="0,0,8,0" Style="{StaticResource AppTextBoxStyle}" Background="{StaticResource CardBgBrush}"
                         Foreground="{StaticResource GreenBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" 
                         VerticalContentAlignment="Center" Padding="10,0" FontWeight="Bold" Text="" PreviewTextInput="NumberTextBox_PreviewTextInput"
                         DataObject.Pasting="NumberTextBox_Pasting" PreviewKeyDown="NumberTextBox_PreviewKeyDown"/>
            </StackPanel>

            <StackPanel x:Name="pnlAdvanceAmount" Grid.Column="0" Grid.Row="3" Visibility="Collapsed">
                <TextBlock Text="Montant de l'avance (DH)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtAdvanceAmount" Height="38" Margin="0,0,8,0" Style="{StaticResource AppTextBoxStyle}" Background="{StaticResource CardBgBrush}"
                Foreground="{StaticResource GreenBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" 
                VerticalContentAlignment="Center" Padding="10,0" FontWeight="Bold" Text=""/>
            </StackPanel>

            <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,0,14">
                <TextBlock Text="Statut de Paiement" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="cbPaymentStatus" Height="38" Style="{StaticResource FilterComboStyle}" Width="NaN" SelectionChanged="cbPaymentStatus_SelectionChanged">
                    <ComboBoxItem Content="En attente" IsSelected="True"/>
                    <!--<ComboBoxItem Content="Terminee"/>-->
                    <ComboBoxItem Content="Avance"/>
                    <!--<ComboBoxItem Content="Remboursé"/>-->
                </ComboBox>
            </StackPanel>

            

            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="8">
                <TextBlock Text="Notes / Remarques (Optionnel)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="txtNotes" Height="auto" 
                         Style="{StaticResource AppTextBoxStyle}"
                         Background="{StaticResource CardBgBrush}" 
                         Foreground="{StaticResource TextPrimaryBrush}" 
                         BorderBrush="{StaticResource BorderBrushSoft}"
                         BorderThickness="1" 
                         AcceptsReturn="True" 
                         TextWrapping="Wrap" 
                         VerticalContentAlignment="Top" 
                         Padding="10,8"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>