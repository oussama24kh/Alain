<UserControl x:Class="project_03.Rental.Controls.RentalDetailsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" MinWidth="550">

    <Border Style="{StaticResource CardStyle}" Padding="24" Margin="12">
        <StackPanel>
            <!-- Header Section (Top Bar) -->
            <Grid Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="8" Background="#1E293B" Margin="0,0,12,0">
                        <iconPacks:PackIconMaterial Kind="FileDocumentOutline" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Détails du Contrat" Style="{StaticResource HeaderTextStyle}" FontSize="15"/>
                        <TextBlock x:Name="txtContractReference" Text="N/A" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontFamily="Consolas"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Badge -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1E293B" CornerRadius="4" Padding="10,4">
                    <TextBlock x:Name="txtStatusBadge" Text="N/A" Foreground="{StaticResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <Separator Background="{StaticResource BorderBrushSoft}" Margin="0,0,0,16"/>

            <!-- HORIZONTAL CONTENT GRID -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- COLUMN 1: Customer & Vehicle Info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock Text="PARTIES CONCERNÉES" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Client:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock x:Name="txtCustomerName" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium"/>
                        <TextBlock x:Name="txtCustomerNationalId" Text="-" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock x:Name="txtCustomerPhone" Text="-" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Véhicule:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock x:Name="txtCarModel" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium"/>
                        <TextBlock x:Name="txtCarPlate" Text="-" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontFamily="Consolas"/>
                    </StackPanel>
                </StackPanel>

                <Separator Grid.Column="1" Width="1" Background="{StaticResource BorderBrushSoft}" Margin="12,0"/>

                <!-- COLUMN 2: Mileage & Odometer -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <TextBlock Text="KILOMÉTRAGE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Départ" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="txtStartMileage" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Retour" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="txtEndMileage" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel>
                        <TextBlock Text="Distance Totale" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock x:Name="txtTotalDistance" Text="-" Foreground="{StaticResource PrimaryBrush}" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <Separator Grid.Column="3" Width="1" Background="{StaticResource BorderBrushSoft}" Margin="12,0"/>

                <!-- COLUMN 3: Dates & Financials -->
                <StackPanel Grid.Column="4" VerticalAlignment="Top">
                    <TextBlock Text="PLANNING &amp; MONTANT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Dates (Début / Prévue / Effective):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock x:Name="txtStartDate" Text="Début: -" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                        <TextBlock x:Name="txtExpectedEndDate" Text="Prévue: -" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                        <TextBlock x:Name="txtActualEndDate" Text="Effective: -" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Montant Total" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock x:Name="txtTotalAmount" Text="0.00 MAD" Foreground="{StaticResource PrimaryBrush}" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>